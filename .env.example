# Copy to .env and fill in. .env is gitignored, never commit it.
# Local model servers (Ollama, vLLM, llama.cpp) usually ignore the key, but the
# OpenAI client requires SOME value, so set a placeholder for local use.
NIA_BRAIN_API_KEY=local-no-key-needed

# Phase 2 vision. Get a free key from Google AI Studio (aistudio.google.com).
# Free tier is fine for development. Leave blank until you enable vision.
GEMINI_API_KEY=
